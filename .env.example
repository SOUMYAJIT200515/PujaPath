# ==============================================================================
# PujaPath Frontend Environment Variables (.env.example)
# ==============================================================================

# Google Maps Platform API Key:
# Required for Maps JavaScript API, Places API (New), and Routes API.
# In Google AI Studio, this is auto-provisioned or set via Secrets.
VITE_GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKeyHere"

# Optional Cloud Map ID (Cloud-based Map Styling)
VITE_GOOGLE_MAPS_ID="DEMO_MAP_ID"

# Backend REST API Base URL (when connected to Spring Boot backend)
VITE_API_BASE_URL="http://localhost:8080/api"

# Application hosting URL (Cloud Run / Vercel)
APP_URL="http://localhost:3000"

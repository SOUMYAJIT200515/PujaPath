# ==============================================================================
# PujaPath Spring Boot Backend Environment Variables (.env.example)
# ==============================================================================

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pujapath_db
DB_USER=pujapath_user
DB_PASSWORD=your_secure_mysql_password_here

# Server Port
PORT=8080

# JWT Security Secret & Expiration
JWT_SECRET=YourSuperSecretDurgaPujaJwtTokenNorthKolkataKeyMinimum256BitsLong
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma separated)
FRONTEND_URL=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# Google Maps API Server Key (for backend routing & places proxy if needed)
GOOGLE_MAPS_SERVER_KEY=AIzaSyYourServerRestrictedKeyHere
